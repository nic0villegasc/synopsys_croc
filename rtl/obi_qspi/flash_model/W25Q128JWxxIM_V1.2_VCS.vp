// *******************************************************************************
// **************** W25Q128JWxxIM-DTR DataSheet Specification *********************
// *******************************************************************************
// CSn timing checks
specparam tSLCH   = 5;		       // CSB Active Setup Time relative to CLK			
specparam tSHSL_R = 10;  	       // CSB De-select Time(for Read)			
specparam tSHSL_W = 50;                // CSB De-select Time(for Erase/Program/Write)
specparam tCHSH   = 3;                 // CSB Active Hold Time relative to CLK
specparam tSHCH   = 3;                 // CSB Not Active Setup Time relative to CLK

// CLK timing checks
specparam tCLH  = 7.5*0.45;            // Minimum CLK high time for all instructions except for Read Data(03h)
specparam tCLL  = 7.5*0.45;            // Minimum CLK low time for all instructions except for Read Data(03h)
specparam tCRLH = 7.5*0.45;            // Minimum CLK high time for Read Data instruction
specparam tCRLL = 7.5*0.45;            // Minimum CLK low time for Read Data instruction

// DIO timing checks
specparam tDVCH = 2;	               // DIO Data setup time
specparam tCHDX = 3;                   // DIO Data hold time

// WPn timing checks
specparam tWHSL = 20;                  // Write Protect Setup Time Before CSB Low
specparam tSHWL = 100;                 // Write Protect Hold Time After CSB High

// HOLDn timing checks
specparam tHLQZ = 12;                  // HOLDB to Output High-Z
specparam tHHQX = 7;                   // HOLDB to Output Low-Z
specparam tSUS  = 20000;               // CSB High to next Instruction after Suspend
specparam tCHHL = 5;                   // HOLDB Not Active Hold Time relative to CLK
specparam tHLCH = 5;                   // HOLDB Active Setup Time relative to CLK
specparam tCHHH = 5;                   // HOLDB Active Hold Time relative to CLK
specparam tHHCH = 5;                   // HOLDB Not Active Setup Time relative to CLK

endspecify

// Other Timing Spec. in Datasheet
parameter tCLQV = 6;	               // Time to DO output valid.
parameter tSHQZ = 7;	               // Data output disable time.
parameter tW    = 1000000;             // Write Status Register Write Time(Typ.)
parameter tRES1 = 200000;	       // Release from power down time 1                              // Change from 3us to 200us - Perseus 190108
parameter tRES2 = 1800;		       // Release from power down time 2
parameter tDP   = 3000;		       // Time for device to enter deep power down.
parameter tPP   = 400000;	       // Page Program Time
parameter tSE   = 45000000;	       // Sector Erase Time.
parameter tBE1  = 120000000;	       // Block Erase Time. 32KB
parameter tBE2  = 150000000;	       // Block Erase Time. 64KB
parameter tCE_40= 1000000000;	       // Chip Erase Time. This constant should be repeated 40 times.

